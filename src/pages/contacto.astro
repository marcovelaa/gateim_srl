---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import FaqSection from '../components/FaqSection.astro';
import { Phone, Mail, MapPin, Clock } from 'lucide-astro';
import faqsData from '../data/faqs.json';

const title = "Contacto | GATEIM SRL";
const description = "Póngase en contacto con GATEIM SRL. Solicite cotizaciones o información sobre nuestros servicios industriales en Santa Cruz, Bolivia.";

const faqs = faqsData.slice(0, 3);
---

<BaseLayout title={title} description={description}>
  <!-- Breadcrumb JSON-LD -->
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://gateim.com.bo/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Contacto"
        }
      ]
    }
  </script>

  <!-- Contact Main Section -->
  <section class="pt-16 pb-20 bg-white">
    <div class="max-w-[1600px] mx-auto px-4 lg:px-12 2xl:px-16 mb-12">
      <p class="text-navy font-bold text-xs tracking-widest uppercase mb-2">CONTACTO</p>
      <h1 class="text-3xl md:text-4xl font-extrabold font-heading text-navy uppercase leading-tight mb-4">
        ESTAMOS LISTOS PARA ATENDER SUS REQUERIMIENTOS INDUSTRIALES
      </h1>
      <p class="text-gray-text text-sm max-w-2xl">
        Complete el formulario o comuníquese directamente con nuestro equipo técnico para recibir asesoría personalizada y cotizaciones.
      </p>
    </div>

    <div class="max-w-[1600px] mx-auto px-4 lg:px-12 2xl:px-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <!-- Contact Info Column (5 cols) -->
        <div class="lg:col-span-5 bg-gray-50 border border-gray-100 p-8 md:p-10">
          <h2 class="text-2xl font-bold font-heading text-navy uppercase mb-8">Información de Contacto</h2>
          
          <div class="space-y-8">
            <div class="flex items-start">
              <div class="bg-gold/10 p-3 rounded-full mr-4 flex-shrink-0">
                <MapPin class="h-6 w-6 text-gold" />
              </div>
              <div>
                <h3 class="text-base font-bold font-heading text-navy mb-1">Dirección</h3>
                <p class="text-gray-text text-sm leading-relaxed">
                  Santa Cruz de la Sierra, Bolivia
                </p>
              </div>
            </div>
            
            <div class="flex items-start">
              <div class="bg-gold/10 p-3 rounded-full mr-4 flex-shrink-0">
                <Phone class="h-6 w-6 text-gold" />
              </div>
              <div>
                <h3 class="text-base font-bold font-heading text-navy mb-1">Teléfonos</h3>
                <p class="text-gray-text text-sm leading-relaxed">
                  +591 3 300 0000 / +591 700 00000
                </p>
              </div>
            </div>
            
            <div class="flex items-start">
              <div class="bg-gold/10 p-3 rounded-full mr-4 flex-shrink-0">
                <Mail class="h-6 w-6 text-gold" />
              </div>
              <div>
                <h3 class="text-base font-bold font-heading text-navy mb-1">Correo Electrónico</h3>
                <p class="text-gray-text text-sm leading-relaxed">
                  contacto@gateim.com.bo
                </p>
              </div>
            </div>
            
            <div class="flex items-start">
              <div class="bg-gold/10 p-3 rounded-full mr-4 flex-shrink-0">
                <Clock class="h-6 w-6 text-gold" />
              </div>
              <div>
                <h3 class="text-base font-bold font-heading text-navy mb-1">Horario de Atención</h3>
                <p class="text-gray-text text-sm leading-relaxed">
                  Lunes a Viernes: 08:00 - 18:00<br/>
                  Soporte de Emergencias: 24/7 (Clientes con contrato)
                </p>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Contact Form Column (7 cols) -->
        <div class="lg:col-span-7 bg-white border border-gray-100 p-8 md:p-10 shadow-sm">
          <h2 class="text-2xl font-bold font-heading text-navy uppercase mb-6">Envíenos un Mensaje</h2>
          <ContactForm />
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-20 bg-gray-light border-t border-gray-200/60">
    <div class="max-w-[1600px] mx-auto px-4 lg:px-12 2xl:px-16">
      <FaqSection 
        title="Consultas Comunes"
        items={faqs}
        addSchema={true}
      />
    </div>
  </section>
</BaseLayout>
