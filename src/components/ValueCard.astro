---
import { ShieldCheck, ClipboardCheck, Lightbulb, Users } from 'lucide-astro';

interface Props {
  title: string;
  description: string;
  icon: string;
}

const { title, description, icon } = Astro.props;

const IconComponent = {
  'shield-check': ShieldCheck,
  'clipboard-check': ClipboardCheck,
  'lightbulb': Lightbulb,
  'users': Users,
}[icon.toLowerCase()] || ShieldCheck;
---

<div class="flex items-start gap-4">
  <div class="bg-navy w-12 h-12 rounded-full flex items-center justify-center flex-shrink-0 shadow-sm">
    <IconComponent class="h-5 w-5 text-gold" />
  </div>
  <div>
    <h3 class="text-sm font-bold font-heading text-navy mb-1 uppercase tracking-wide">{title}</h3>
    <p class="text-xs text-gray-text leading-relaxed">{description}</p>
  </div>
</div>
