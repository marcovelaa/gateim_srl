---
import { Award, Briefcase, Users, PhoneCall } from 'lucide-astro';

interface Props {
  number: string;
  label: string;
  icon: string;
}

const { number, label, icon } = Astro.props;

const IconComponent = {
  'award': Award,
  'briefcase': Briefcase,
  'users': Users,
  'phone-call': PhoneCall,
}[icon.toLowerCase()] || Award;
---

<div class="flex items-center gap-4 justify-center py-2 px-4 group">
  <div class="w-12 h-12 rounded-full border border-gold/40 bg-navy-light flex items-center justify-center flex-shrink-0 group-hover:border-gold group-hover:bg-gold/20 transition-all duration-300">
    <IconComponent class="h-6 w-6 text-gold" stroke-width="1.75" />
  </div>
  <div class="flex flex-col text-left">
    <span class="text-3xl lg:text-4xl font-extrabold font-heading text-white leading-none tracking-tight mb-1 group-hover:text-gold transition-colors">
      {number}
    </span>
    <span class="text-[0.65rem] lg:text-xs font-bold text-gray-300 uppercase tracking-widest leading-tight">
      {label}
    </span>
  </div>
</div>
