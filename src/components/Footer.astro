---
import { Facebook, Linkedin, Instagram } from 'lucide-astro';
const year = new Date().getFullYear();
---

<footer class="bg-navy text-white pt-8 pb-5 border-t border-gray-800">
  <div class="max-w-[1600px] mx-auto px-4 lg:px-12 2xl:px-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      
      <!-- Company Info (3 cols) -->
      <div class="md:col-span-3">
        <a href="/" class="flex items-center gap-3 mb-3 focus:outline-none">
          <img 
            src="/images/logo-gateim3.png" 
            alt="Isotipo GATEIM SRL" 
            class="h-10 w-auto object-contain flex-shrink-0" 
          />
          <div class="flex flex-col items-center text-center justify-center">
            <span class="text-sm font-heading font-semibold text-white tracking-[0.12em] leading-none mb-0.5">
              GATEIM SRL
            </span>
            <span class="text-[0.42rem] text-white font-bold tracking-[0.15em] leading-tight uppercase">
              ASISTENCIA TÉCNICA
            </span>
            <span class="text-[0.42rem] text-white font-bold tracking-[0.15em] leading-tight uppercase">
              INDUSTRIAL Y MECÁNICA
            </span>
            <div class="w-5 h-[1px] bg-gold mt-0.5"></div>
          </div>
        </a>
        <p class="text-gray-400 text-xs mb-3 leading-relaxed">
          Soluciones industriales con calidad, seguridad y compromiso.
        </p>
        <div class="flex space-x-3 text-gray-400">
          <a href="[PENDIENTE]" class="hover:text-gold transition-colors" title="Facebook">
            <Facebook class="h-4 w-4" />
          </a>
          <a href="[PENDIENTE]" class="hover:text-gold transition-colors" title="LinkedIn">
            <Linkedin class="h-4 w-4" />
          </a>
          <a href="[PENDIENTE]" class="hover:text-gold transition-colors" title="Instagram">
            <Instagram class="h-4 w-4" />
          </a>
          <a href="https://wa.me/[PENDIENTE]" class="hover:text-gold transition-colors" title="WhatsApp">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </a>
        </div>
      </div>

      <!-- Enlaces Rápidos (3 cols -> 2-column grid inside) -->
      <div class="md:col-span-3">
        <h3 class="text-xs font-heading font-bold mb-3 text-white uppercase tracking-wider">ENLACES RÁPIDOS</h3>
        <ul class="grid grid-cols-2 gap-x-4 gap-y-1.5">
          <li><a href="/" class="text-gray-400 hover:text-gold transition-colors text-xs">Inicio</a></li>
          <li><a href="/nosotros" class="text-gray-400 hover:text-gold transition-colors text-xs">Nosotros</a></li>
          <li><a href="/servicios" class="text-gray-400 hover:text-gold transition-colors text-xs">Servicios</a></li>
          <li><a href="/proyectos" class="text-gray-400 hover:text-gold transition-colors text-xs">Proyectos</a></li>
          <li><a href="/clientes" class="text-gray-400 hover:text-gold transition-colors text-xs">Clientes</a></li>
          <li><a href="/contacto" class="text-gray-400 hover:text-gold transition-colors text-xs">Contacto</a></li>
        </ul>
      </div>

      <!-- Servicios (4 cols -> 2-column grid inside) -->
      <div class="md:col-span-4">
        <h3 class="text-xs font-heading font-bold mb-3 text-white uppercase tracking-wider">SERVICIOS</h3>
        <ul class="grid grid-cols-2 gap-x-4 gap-y-1.5">
          <li><a href="/servicios" class="text-gray-400 hover:text-gold transition-colors text-xs">Mantenimiento Industrial</a></li>
          <li><a href="/servicios" class="text-gray-400 hover:text-gold transition-colors text-xs">Montaje Industrial</a></li>
          <li><a href="/servicios" class="text-gray-400 hover:text-gold transition-colors text-xs">Fabricación y Mecanizado</a></li>
          <li><a href="/servicios" class="text-gray-400 hover:text-gold transition-colors text-xs">Soldadura Industrial</a></li>
          <li><a href="/servicios" class="text-gray-400 hover:text-gold transition-colors text-xs">Instrumentación y Control</a></li>
          <li><a href="/servicios" class="text-gray-400 hover:text-gold transition-colors text-xs">Paradas de Planta</a></li>
        </ul>
      </div>

      <!-- Certificaciones -->
      <div class="md:col-span-2">
        <h3 class="text-xs font-heading font-bold mb-3 text-white uppercase tracking-wider">CERTIFICACIONES</h3>
        <div class="flex items-center gap-3">
          <img src="/images/certificaciones/iso-9001.svg" alt="Certificación ISO 9001" class="w-14 h-14 transition-transform hover:scale-105" />
          <img src="/images/certificaciones/iso-14001.svg" alt="Certificación ISO 14001" class="w-14 h-14 transition-transform hover:scale-105" />
          <img src="/images/certificaciones/iso-45001.svg" alt="Certificación ISO 45001" class="w-14 h-14 transition-transform hover:scale-105" />
        </div>
      </div>

    </div>
  </div>
</footer>
