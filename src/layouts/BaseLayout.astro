---
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/700.css';
import '@fontsource/montserrat/800.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/gateim_srl/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/gateim_srl/images/og-image.jpg', Astro.site)} />
    
    <!-- JSON-LD LocalBusiness -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "GATEIM SRL",
        "image": "https://gateim.com.bo/gateim_srl/images/logo.png",
        "@id": "https://gateim.com.bo",
        "url": "https://gateim.com.bo",
        "telephone": "[PENDIENTE: confirmar]",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "[PENDIENTE: confirmar]",
          "addressLocality": "Santa Cruz de la Sierra",
          "addressRegion": "Santa Cruz",
          "addressCountry": "BO"
        },
        "openingHoursSpecification": {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday"
          ],
          "opens": "08:00",
          "closes": "18:00"
        }
      }
    </script>
    
    <!-- JSON-LD Organization -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "GATEIM SRL",
        "url": "https://gateim.com.bo",
        "logo": "https://gateim.com.bo/gateim_srl/images/logo.png"
      }
    </script>
  </head>
  <body class="flex flex-col min-h-screen">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
